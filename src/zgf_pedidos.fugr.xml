       <KIND>P</KIND>
       <STEXT>Código do produto</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_ID_PROD_HIGH</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Código do produto</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_STATUS</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Status do pedido</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>CT_RELATORIO</PARAMETER>
