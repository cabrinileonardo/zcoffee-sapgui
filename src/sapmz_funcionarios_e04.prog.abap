MODULE pbo_9004 OUTPUT.
  SET PF-STATUS 'S9004'.
  SET TITLEBAR 'DEL'.
ENDMODULE.

MODULE pai_9004 INPUT.
  CASE gd_okcode.
    WHEN 'DEL'.
      PERFORM excluir.
    WHEN 'BACK' OR ''.
      LEAVE TO SCREEN 0100.
  ENDCASE.
ENDMODULE.



